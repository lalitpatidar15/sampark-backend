# ---------------------------------------------------------------------------
# Sampark.me backend — local development environment
# Copy to .env and replace every secret before any non-local deployment.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
APP_NAME=Sampark
LOG_LEVEL=debug

# --- Data stores (31B.4 free/self-hosted development stack) ---
DATABASE_URL=postgresql://sampark:sampark@localhost:5432/sampark?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-hex-32-output-000
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-hex-32-output-111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Field-level encryption (9.1 AES-256-GCM) ---
# 32-byte key as 64 hex chars. Rotating: move current to FIELD_ENCRYPTION_KEY_V1.
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32-output-0000000000000000
# FIELD_ENCRYPTION_KEY_V1=

# --- Deterministic lookup HMAC for phone/email/registration (9.2) ---
LOOKUP_HMAC_KEY=replace-me-lookup-hmac-key
OTP_SECRET=replace-me-otp-secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19006

# --- Rate limits ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SCANNER_RATE_LIMIT_MAX=10

# --- Communication providers (mock = local development, no external calls) ---
VOICE_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=mock

# --- Razorpay (store / tag sales) ---
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# --- Communication policy ---
MAX_CALL_DURATION_SECONDS=300
CALL_RECORDING_ENABLED=false
DEFAULT_LOCATION_SHARE_TTL_MINUTES=30
DEFAULT_CHAT_TTL_HOURS=24
MAX_ATTACHMENT_BYTES=10485760
