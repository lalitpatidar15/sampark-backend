// Sampark.me — Privacy-Preserving QR Contact Platform
// Data model follows the spec's separation of public identity from private identity:
// sensitive fields are stored as *_encrypted (AES-256-GCM) plus *_lookup_hmac
// (keyed HMAC) so a database dump does not expose raw personal data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  OWNER
  FAMILY_MANAGER
  FAMILY_VIEWER
  EMERGENCY_CONTACT
  SOCIETY_OPERATOR
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

model User {
  id     String     @id @default(uuid()) @db.Uuid
  publicId String   @unique
  role   UserRole   @default(OWNER)
  status UserStatus @default(PENDING_VERIFICATION)

  // Private identity — never projected into public scanner responses.
  nameEncrypted        String? @map("name_encrypted")
  phoneEncrypted       String  @map("phone_encrypted")
  phoneLookupHmac      String  @unique @map("phone_lookup_hmac")
  emailEncrypted       String? @map("email_encrypted")
  emailLookupHmac      String? @unique @map("email_lookup_hmac")

  pushTokenEncrypted   String? @map("push_token_encrypted")
  platform             String?
  appVersion           String? @map("app_version")

  // Owner-controlled privacy preferences (spec 4.1, 8.1).
  enabledChannels      String[] @default(["VOICE", "SMS", "WHATSAPP", "CHAT"]) @map("enabled_channels")
  allowLocationShare   Boolean  @default(false) @map("allow_location_share")
  allowVideoCalls      Boolean  @default(false) @map("allow_video_calls")
  allowUnknownCallers  Boolean  @default(true) @map("allow_unknown_callers")
  quietHoursStart      String? @map("quiet_hours_start")
  quietHoursEnd        String? @map("quiet_hours_end")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Admin step-up MFA (TOTP, RFC 6238).
  mfaSecret        String?   @map("mfa_secret")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaRecoveryCodes String?   @map("mfa_recovery_codes")

  assets                Asset[]
  vehicles              Vehicle[]
  tags                  Tag[]
  devices               Device[]
  refreshTokens         RefreshToken[]
  familyMembers         FamilyMember[]     @relation("FamilyOwner")
  familyMemberships     FamilyMembership[] @relation("FamilyMemberUser")
  linkedFromFamily      FamilyMember[]     @relation("LinkedFamilyUser")
  emergencyContacts     EmergencyContact[]
  communicationSessions CommunicationSession[]
  locationShares        LocationShare[]
  documents             Document[]
  orders                Order[]
  subscriptions         Subscription[]
  societies             Society[]
  auditLogs             AuditLog[]
  tickets               SupportTicket[]
  residencies           Resident[]
  reminders             Reminder[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jti       String   @unique
  userAgent String?  @map("user_agent")
  ipHash    String?  @map("ip_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  devicePublicId   String   @unique @map("device_public_id")
  platform         String
  appVersion       String?  @map("app_version")
  pushTokenEncrypted String? @map("push_token_encrypted")
  riskState        String   @default("TRUSTED") @map("risk_state")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

// ---------------------------------------------------------------------------
// Assets, tags, vehicles
// ---------------------------------------------------------------------------

enum AssetType {
  VEHICLE
  BIKE
  HOME_DOOR
  OFFICE
  SOCIETY
  PARKING
  PROFESSIONAL
  BUSINESS
  DELIVERY
  EQUIPMENT
  OTHER
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  assetType   AssetType @map("asset_type")
  displayName String    @map("display_name")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?
  documents Document[]
  locationShares LocationShare[]
  tags      Tag[]
  emergencyProfile EmergencyProfile?

  @@index([ownerId])
  @@map("assets")
}

enum TagType {
  PHYSICAL_QR
  DIGITAL_QR
  NFC
  QR_NFC
  DOOR
  VEHICLE
  BIKE
  PARKING
  PROFESSIONAL
  BUSINESS
}

enum TagStatus {
  CREATED
  UNASSIGNED
  ACTIVATION_PENDING
  ACTIVE
  SUSPENDED
  TRANSFER_PENDING
  TRANSFERRED
  DEACTIVATED
  LOST
}

model Tag {
  id             String    @id @default(uuid()) @db.Uuid
  publicTagId    String    @unique @map("public_tag_id")
  // Tokens are high-entropy and stored hashed so a dump cannot enumerate live tags.
  publicTokenHash String   @unique @map("public_token_hash")
  // Encrypted copy so the authenticated owner can re-render a QR at any time
  // without the token ever being readable from a database dump.
  publicTokenEncrypted String @map("public_token_encrypted")
  tagType        TagType   @map("tag_type")
  status         TagStatus @default(CREATED)
  assetId        String?   @map("asset_id") @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  nfcUidHash     String?   @unique @map("nfc_uid_hash")
  label          String?
  activatedAt    DateTime? @map("activated_at")
  deactivatedAt  DateTime? @map("deactivated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset         Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  events        TagEvent[]
  scannerSessions ScannerSession[]
  communicationSessions CommunicationSession[]
  geofence      Geofence?
  transferRequests TagTransfer[]
  physicalTag   PhysicalTag?

  @@index([ownerId])
  @@index([status])
  @@map("tags")
}

model TagTransfer {
  id          String   @id @default(uuid()) @db.Uuid
  tagId       String   @map("tag_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  status      String   @default("PENDING")
  otpSentTo   String?  @map("otp_sent_to")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tag      Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
  @@map("tag_transfers")
}

model Vehicle {
  id                      String   @id @default(uuid()) @db.Uuid
  assetId                 String   @unique @map("asset_id") @db.Uuid
  ownerId                 String   @map("owner_id") @db.Uuid
  registrationEncrypted   String   @map("registration_encrypted")
  registrationLookupHmac  String   @unique @map("registration_lookup_hmac")
  registrationEnding      String   @map("registration_ending")
  make                    String?
  model                   String?
  variant                 String?
  color                   String?
  year                    Int?
  vehicleType             String?  @map("vehicle_type")
  fuelType                String?  @map("fuel_type")
  status                  String   @default("ACTIVE")
  insuranceExpiry         DateTime? @map("insurance_expiry") @db.Date
  pucExpiry               DateTime? @map("puc_expiry") @db.Date
  fastagStatus            String?  @map("fastag_status")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  activityEvents VehicleEvent[]
  reminders      Reminder[]
  parkingAllocations ParkingAllocation[]

  @@index([ownerId])
  @@index([registrationLookupHmac])
  @@map("vehicles")
}

enum AssetEventType {
  TAG_SCAN
  CALL_STARTED
  CALL_ENDED
  SMS_SENT
  WHATSAPP_SENT
  MESSAGE_SENT
  LOCATION_SHARED
  VEHICLE_IN
  VEHICLE_OUT
  EMERGENCY_TRIGGERED
  TAG_ACTIVATED
  TAG_DEACTIVATED
  TAG_TRANSFERRED
}

model TagEvent {
  id               String         @id @default(uuid()) @db.Uuid
  tagId            String         @map("tag_id") @db.Uuid
  eventType        AssetEventType @map("event_type")
  scannerSessionId String?        @map("scanner_session_id") @db.Uuid
  metadata         Json?
  ipHash           String?        @map("ip_hash")
  createdAt        DateTime       @default(now()) @map("created_at")

  tag            Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  scannerSession ScannerSession? @relation(fields: [scannerSessionId], references: [id], onDelete: SetNull)

  @@index([tagId, createdAt])
  @@map("tag_events")
}

model VehicleEvent {
  id        String         @id @default(uuid()) @db.Uuid
  vehicleId String         @map("vehicle_id") @db.Uuid
  tagId     String?        @map("tag_id") @db.Uuid
  eventType AssetEventType @map("event_type")
  description String?
  geo       Json?
  createdAt DateTime       @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("vehicle_events")
}

// ---------------------------------------------------------------------------
// Scanner / privacy gateway
// ---------------------------------------------------------------------------

model ScannerSession {
  id                   String   @id @default(uuid()) @db.Uuid
  publicSessionId      String   @unique @map("public_session_id")
  sessionTokenHash     String   @unique @map("session_token_hash")
  tagId                String   @map("tag_id") @db.Uuid
  reasonCode           String?  @map("reason_code")
  phoneLookupHmac      String?  @map("phone_lookup_hmac")
  phoneVerified        Boolean  @default(false) @map("phone_verified")
  ipHash               String?  @map("ip_hash")
  deviceFingerprintHash String? @map("device_fingerprint_hash")
  userAgent            String?  @map("user_agent")
  riskScore            Int      @default(0)
  riskState            String   @default("LOW") @map("risk_state")
  status               String   @default("ACTIVE")
  expiresAt            DateTime @map("expires_at")
  createdAt            DateTime @default(now()) @map("created_at")

  tag              Tag                    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagEvents        TagEvent[]
  communications   CommunicationSession[]
  emergencyAlerts  EmergencyAlert[]
  locationRequests LocationShareRequest[]

  @@index([tagId, createdAt])
  @@index([ipHash])
  @@index([expiresAt])
  @@map("scanner_sessions")
}

// ---------------------------------------------------------------------------
// Communication
// ---------------------------------------------------------------------------

enum Channel {
  VOICE
  VIDEO
  SMS
  WHATSAPP
  CHAT
  PUSH
}

enum CommunicationStatus {
  CREATED
  PENDING
  RINGING
  ACTIVE
  COMPLETED
  FAILED
  REJECTED
  EXPIRED
  CANCELLED
}

model CommunicationSession {
  id               String              @id @default(uuid()) @db.Uuid
  publicSessionId  String              @unique @map("public_session_id")
  tagId            String              @map("tag_id") @db.Uuid
  ownerId          String              @map("owner_id") @db.Uuid
  scannerSessionId String              @map("scanner_session_id") @db.Uuid
  channel          Channel
  status           CommunicationStatus @default(CREATED)
  reasonCode       String?             @map("reason_code")
  provider         String?
  providerSessionId String?            @map("provider_session_id")
  // A platform-owned relay number the scanner dials, or a provider reference.
  // Never either party's real phone number.
  relayReference   String?             @map("relay_reference")
  riskScore        Int                 @default(0) @map("risk_score")
  requiresOtp      Boolean             @default(false) @map("requires_otp")
  startedAt        DateTime?           @map("started_at")
  connectedAt      DateTime?           @map("connected_at")
  endedAt          DateTime?           @map("ended_at")
  expiresAt        DateTime            @map("expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  tag            Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scannerSession ScannerSession @relation(fields: [scannerSessionId], references: [id], onDelete: Cascade)
  call           CallSession?
  messages       Message[]

  @@index([tagId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status])
  @@map("communication_sessions")
}

model CallSession {
  id                     String   @id @default(uuid()) @db.Uuid
  communicationSessionId String   @unique @map("communication_session_id") @db.Uuid
  relayNumberReference   String   @map("relay_number_reference")
  callerReference        String   @map("caller_reference")
  calleeReference        String   @map("callee_reference")
  providerCallSid        String?  @map("provider_call_sid")
  status                 String   @default("INITIATED")
  durationSeconds        Int      @default(0)
  // Recording is off by default (spec 10.4); reference only, never a URL.
  recordingReference     String?  @map("recording_reference")
  hangupReason           String?  @map("hangup_reason")
  createdAt              DateTime @default(now()) @map("created_at")
  endedAt                DateTime? @map("ended_at")

  communicationSession CommunicationSession @relation(fields: [communicationSessionId], references: [id], onDelete: Cascade)

  @@map("call_sessions")
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  EXPIRED
  BLOCKED
}

model Message {
  id                     String        @id @default(uuid()) @db.Uuid
  communicationSessionId String        @map("communication_session_id") @db.Uuid
  senderType             String        @map("sender_type")
  senderReference        String        @map("sender_reference")
  recipientType          String        @map("recipient_type")
  recipientReference     String        @map("recipient_reference")
  channel                Channel
  bodyCiphertext         String        @map("body_ciphertext")
  status                 MessageStatus @default(QUEUED)
  providerMessageId      String?       @map("provider_message_id")
  templateKey            String?       @map("template_key")
  moderationState        String?       @map("moderation_state")
  createdAt              DateTime      @default(now()) @map("created_at")
  expiresAt              DateTime      @map("expires_at")

  communicationSession CommunicationSession @relation(fields: [communicationSessionId], references: [id], onDelete: Cascade)

  @@index([communicationSessionId, createdAt])
  @@map("messages")
}

model OtpChallenge {
  id            String   @id @default(uuid()) @db.Uuid
  subjectHash   String   @map("subject_hash")
  purpose       String
  codeHash      String   @map("code_hash")
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5) @map("max_attempts")
  consumedAt    DateTime? @map("consumed_at")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([subjectHash, purpose])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Emergency, location, geofence
// ---------------------------------------------------------------------------

model EmergencyContact {
  id                     String   @id @default(uuid()) @db.Uuid
  ownerId                String   @map("owner_id") @db.Uuid
  nameEncrypted          String   @map("name_encrypted")
  relationshipEncrypted  String   @map("relationship_encrypted")
  phoneEncrypted         String   @map("phone_encrypted")
  phoneLookupHmac        String?  @map("phone_lookup_hmac")
  priority               Int      @default(1)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, enabled])
  @@map("emergency_contacts")
}

model EmergencyProfile {
  id                           String   @id @default(uuid()) @db.Uuid
  assetId                      String   @unique @map("asset_id") @db.Uuid
  bloodGroupEncrypted          String?  @map("blood_group_encrypted")
  insuranceProviderEncrypted   String?  @map("insurance_provider_encrypted")
  insurancePolicyEncrypted     String?  @map("insurance_policy_encrypted")
  firstResponderNoteEncrypted  String?  @map("first_responder_note_encrypted")
  enabled                      Boolean  @default(true)
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("emergency_profiles")
}

model EmergencyAlert {
  id                   String   @id @default(uuid()) @db.Uuid
  scannerSessionId     String   @map("scanner_session_id") @db.Uuid
  ownerId              String   @map("owner_id") @db.Uuid
  reasonCode           String?  @map("reason_code")
  note                 String?
  riskScore            Int      @default(0) @map("risk_score")
  status               String   @default("RAISED")
  notifiedContactIds   String[] @default([]) @map("notified_contact_ids")
  createdAt            DateTime @default(now()) @map("created_at")
  resolvedAt           DateTime? @map("resolved_at")

  scannerSession ScannerSession @relation(fields: [scannerSessionId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("emergency_alerts")
}

model LocationShareRequest {
  id               String   @id @default(uuid()) @db.Uuid
  scannerSessionId String   @map("scanner_session_id") @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at")
  respondedAt      DateTime? @map("responded_at")

  scannerSession ScannerSession @relation(fields: [scannerSessionId], references: [id], onDelete: Cascade)
  share          LocationShare?

  @@index([ownerId, status])
  @@map("location_share_requests")
}

model LocationShare {
  id                 String   @id @default(uuid()) @db.Uuid
  publicShareId      String   @unique @map("public_share_id")
  requestId          String?  @unique @map("request_id") @db.Uuid
  ownerId            String   @map("owner_id") @db.Uuid
  assetId            String?  @map("asset_id") @db.Uuid
  locationCiphertext String   @map("location_ciphertext")
  accuracyMeters     Int?     @map("accuracy_meters")
  status             String   @default("ACTIVE")
  viewCount          Int      @default(0) @map("view_count")
  createdAt          DateTime @default(now()) @map("created_at")
  expiresAt          DateTime @map("expires_at")

  request LocationShareRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  owner   User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset   Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([expiresAt])
  @@map("location_shares")
}

model Geofence {
  id              String   @id @default(uuid()) @db.Uuid
  tagId           String   @unique @map("tag_id") @db.Uuid
  centerCiphertext String  @map("center_ciphertext")
  radiusMeters    Int      @default(150) @map("radius_meters")
  allowedChannels Channel[] @default([CHAT, VOICE]) @map("allowed_channels")
  activeSchedule  String?  @map("active_schedule")
  cooldownMinutes Int      @default(60) @map("cooldown_minutes")
  alertOnProximity Boolean  @default(false) @map("alert_on_proximity")
  enabled         Boolean  @default(false)
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("geofences")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  REGISTRATION_CERTIFICATE
  INSURANCE
  PUC
  FASTAG
  SERVICE_RECORD
  IDENTITY
  OTHER
}

enum DocumentStatus {
  PENDING_SCAN
  AVAILABLE
  QUARANTINED
  REJECTED
  EXPIRED
}

model Document {
  id                     String         @id @default(uuid()) @db.Uuid
  ownerId                String         @map("owner_id") @db.Uuid
  assetId                String?        @map("asset_id") @db.Uuid
  documentType           DocumentType   @map("document_type")
  objectKey              String         @map("object_key")
  checksum               String
  encryptionKeyReference String?        @map("encryption_key_reference")
  status                 DocumentStatus @default(PENDING_SCAN)
  scanFinding            String?        @map("scan_finding")
  expiresAt              DateTime?      @map("expires_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([ownerId, documentType])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Family, society, parking
// ---------------------------------------------------------------------------

enum FamilyPermission {
  VIEW
  RECEIVE_ALERTS
  REPLY
  MANAGE_TAGS
  EMERGENCY_ONLY
}

model FamilyMember {
  id               String   @id @default(uuid()) @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  nameEncrypted    String   @map("name_encrypted")
  relationshipEncrypted String @map("relationship_encrypted")
  phoneEncrypted   String   @map("phone_encrypted")
  phoneLookupHmac  String?  @map("phone_lookup_hmac")
  linkedUserId     String?  @map("linked_user_id") @db.Uuid
  permissions      FamilyPermission[] @default([VIEW])
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner   User               @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  linkedUser User?            @relation("LinkedFamilyUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  memberships FamilyMembership[]

  @@index([ownerId])
  @@map("family_members")
}

model FamilyMembership {
  id             String   @id @default(uuid()) @db.Uuid
  familyMemberId String   @map("family_member_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  grantedAt      DateTime @default(now()) @map("granted_at")

  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  user         User         @relation("FamilyMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyMemberId, userId])
  @@map("family_memberships")
}

model Society {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  ownerId        String   @map("owner_id") @db.Uuid
  cityEncrypted  String?  @map("city_encrypted")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buildings Building[]
  parkingSlots ParkingSlot[]
  staff     SocietyStaff[]

  @@index([ownerId])
  @@map("societies")
}

model SocietyStaff {
  id          String   @id @default(uuid()) @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("SECURITY")
  createdAt   DateTime @default(now()) @map("created_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, userId])
  @@map("society_staff")
}

model Building {
  id              String   @id @default(uuid()) @db.Uuid
  societyId       String   @map("society_id") @db.Uuid
  name            String
  addressCiphertext String? @map("address_ciphertext")
  createdAt       DateTime @default(now()) @map("created_at")

  society   Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flats     Flat[]
  parkingSlots ParkingSlot[]

  @@index([societyId])
  @@map("buildings")
}

model Flat {
  id          String   @id @default(uuid()) @db.Uuid
  buildingId  String   @map("building_id") @db.Uuid
  flatNumber  String   @map("flat_number")
  ownerId     String?  @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  building Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residents Resident[]
  parkingSlots ParkingSlot[]

  @@unique([buildingId, flatNumber])
  @@map("flats")
}

model Resident {
  id        String   @id @default(uuid()) @db.Uuid
  flatId    String   @map("flat_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  flat Flat  @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flatId, userId])
  @@map("residents")
}

model ParkingSlot {
  id            String   @id @default(uuid()) @db.Uuid
  societyId     String   @map("society_id") @db.Uuid
  buildingId    String?  @map("building_id") @db.Uuid
  flatId        String?  @map("flat_id") @db.Uuid
  slotCode      String   @map("slot_code")
  slotType      String   @default("RESIDENT") @map("slot_type")
  status        String   @default("AVAILABLE")
  qrTagId       String?  @map("qr_tag_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  society   Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  building  Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  flat      Flat?               @relation(fields: [flatId], references: [id], onDelete: SetNull)
  allocations ParkingAllocation[]

  @@unique([societyId, slotCode])
  @@map("parking_slots")
}

model ParkingAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  slotId      String   @map("slot_id") @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  startsAt    DateTime @default(now()) @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")

  slot    ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("parking_allocations")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

enum OrderStatus {
  CREATED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  orderNumber    String        @unique @map("order_number")
  userId         String?       @map("user_id") @db.Uuid
  accessToken    String?       @unique @map("access_token")
  status         OrderStatus   @default(CREATED)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  currency       String        @default("INR")
  subtotal       Int
  tax            Int           @default(0)
  discount       Int           @default(0)
  shippingFee    Int           @default(0) @map("shipping_fee")
  total          Int
  addressCiphertext String?    @map("address_ciphertext")
  provider       String?
  providerOrderId String?      @map("provider_order_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  address   Address?
  payments  Payment[]
  shipments Shipment[]

  @@index([userId, createdAt])
  @@index([orderNumber])
  @@index([accessToken])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productCode String   @map("product_code")
  description String
  quantity    Int      @default(1)
  unitPrice   Int      @map("unit_price")
  total       Int

  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation("orderItemProduct", fields: [productId], references: [id], onDelete: SetNull)
  physicalTag PhysicalTag?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planCode               String             @map("plan_code")
  status                 SubscriptionStatus @default(TRIALING)
  paymentStatus          PaymentStatus      @default(PENDING) @map("payment_status")
  provider               String?
  providerSubscriptionId String?            @map("provider_subscription_id")
  seats                  Int                @default(1)
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  cancelAt               DateTime?          @map("cancel_at")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Platform operations
// ---------------------------------------------------------------------------

model ProviderConfig {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  providerType String   @map("provider_type")
  isActive     Boolean  @default(false)
  // Credentials live in the KMS/Vault in production; only a reference here.
  secretRef    String?  @map("secret_ref")
  config       Json?
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("provider_configs")
}

model SupportTicket {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  subject     String
  category    String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  assignedTo  String?  @map("assigned_to") @db.Uuid
  body        String
  resolution  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@map("support_tickets")
}

model AbuseReport {
  id             String   @id @default(uuid()) @db.Uuid
  reporterType   String   @map("reporter_type")
  reporterRef    String   @map("reporter_ref")
  tagId          String?  @map("tag_id") @db.Uuid
  scannerSessionId String? @map("scanner_session_id") @db.Uuid
  reason         String
  details        String?
  riskScore      Int      @default(0) @map("risk_score")
  state          String   @default("OPEN")
  actionTaken    String?  @map("action_taken")
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  @@index([tagId])
  @@index([state])
  @@map("abuse_reports")
}

model FeatureFlag {
  key        String   @id
  enabled    Boolean  @default(false)
  rolloutPct Int      @default(100) @map("rollout_pct")
  rules      Json?
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model QrSizeConfig {
  id          String   @id @default(uuid()) @db.Uuid
  size        Int      @unique
  label       String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("qr_size_configs")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorRole     String?  @map("actor_role")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  outcome       String   @default("SUCCESS")
  ipHash        String?  @map("ip_hash")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model DailyMetric {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  metric    String
  dimensions Json?
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, metric])
  @@index([metric, date])
  @@map("daily_metrics")
}

model Reminder {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  vehicleId  String?  @map("vehicle_id") @db.Uuid
  reminderType String @map("reminder_type")
  title      String
  dueAt      DateTime @map("due_at")
  status     String   @default("PENDING")
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@map("reminders")
}

/// Durable idempotency ledger for inbound provider webhooks (spec 32.2).
/// The first delivery of an event claims the row; provider retries become no-ops.
model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  handler         String
  providerEventId String   @map("provider_event_id")
  payloadDigest   String?  @map("payload_digest")
  receivedAt      DateTime @default(now()) @map("received_at")

  @@unique([handler, providerEventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

/// ---------------------------------------------------------------------------
/// Store / Tag Sales domain (revenue model).
///
/// Keeps physical tag inventory, orders and payments separate from the privacy
/// gateway so introducing commerce does not alter existing tag behaviour.
/// Money is stored as integer paise (₹499 = 49900). Product details are
/// snapshotted onto order items so historical orders never drift when a
/// catalogue price changes.
/// ---------------------------------------------------------------------------

/// Public catalogue. Only `active` products can be purchased.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @map("sku")
  name        String   @map("name")
  description String?  @map("description")
  pricePaise  Int      @map("price_paise")
  currency    String   @default("INR") @map("currency")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[] @relation("orderItemProduct")
  inventory  Inventory?

  @@index([active])
  @@index([sku])
  @@map("products")
}

/// Delivery snapshot.
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  name        String   @map("name")
  phone       String   @map("phone")
  addressLines String  @map("address_lines")
  city        String   @map("city")
  state       String   @map("state")
  postalCode  String   @map("postal_code")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("addresses")
}

/// Payment reconciliation. Provider credentials are never stored; only provider
/// references and status are kept.
model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  provider         String   @map("provider")
  providerOrderId  String   @map("provider_order_id")
  providerPaymentId String? @map("provider_payment_id")
  status           String   @default("UNPAID") @map("status")
  amountPaise      Int      @map("amount_paise")
  currency         String   @default("INR") @map("currency")
  createdAt        DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

/// Physical stock for catalogue products.
model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @map("product_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

/// A printed physical QR tag. Serial numbers are stored separately from public
/// QR tokens and are linked to exactly one digital `Tag` record.
model PhysicalTag {
  id          String   @id @default(uuid()) @db.Uuid
  serialNumber String  @unique @map("serial_number")
  tagId       String   @unique @map("tag_id") @db.Uuid
  status      String   @default("UNASSIGNED") @map("status")
  orderItemId String?   @unique @map("order_item_id") @db.Uuid

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([serialNumber])
  @@index([tagId])
  @@index([orderItemId])
  @@map("physical_tags")
}

model Shipment {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  carrier      String   @map("carrier")
  trackingNumber String? @map("tracking_number")
  status       String   @default("PENDING") @map("status")
  shippedAt    DateTime? @map("shipped_at")
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  providerRefundId String   @map("provider_refund_id")
  amountPaise      Int      @map("amount_paise")
  status           String   @default("PENDING") @map("status")
  createdAt        DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerRefundId])
  @@map("refunds")
}
